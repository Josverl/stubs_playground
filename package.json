{
  "name": "mp-codemirror-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "CodeMirror MicroPython playground and reusable browser LSP packages",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:worker": "webpack --mode production",
    "build:worker:dev": "webpack --mode development",
    "build:typeshed": "uv run scripts/pack-typeshed.py",
    "generate:component-config": "node scripts/generate-component-config.mjs",
    "check:component-config": "node scripts/generate-component-config.mjs --check",
    "check:worker-protocol-types": "node scripts/check-worker-protocol-types.mjs",
    "check:test-boundaries": "node scripts/check-test-boundaries.mjs",
    "test:app:unit": "npm test --workspace @mp-codemirror/playground",
    "test:lsp-client:unit": "npm test --workspace @mp-codemirror/lsp-client",
    "test:pyright-worker:unit": "npm test --workspace @mp-codemirror/pyright-worker",
    "test:components:unit": "npm run test:lsp-client:unit && npm run test:pyright-worker:unit",
    "test:unit": "npm run test:app:unit && npm run test:components:unit"
  },
  "devDependencies": {
    "@zenfs/archives": "1.0.5",
    "@zenfs/core": "1.11.4",
    "archiver": "^8.0.0",
    "arraybuffer-loader": "^1.0.8",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "pyright": "git+https://github.com/microsoft/pyright.git#1.1.386",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "jsonc-parser": "^3.3.1",
    "leven": "^4.1.0",
    "path-browserify": "^1.0.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.1.0"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
