{
  "name": "@mp-typing/pyright-worker",
  "version": "0.4.6",
  "description": "Worker-side protocol contract and packaging metadata",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Josverl/stubs_playground.git",
    "directory": "packages/pyright-worker"
  },
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "changelog.md",
    "THIRD_PARTY_LICENSES.txt",
    "src/declarations.d.ts",
    "src/messages.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run typecheck && node ../../scripts/check-worker-protocol-types.mjs && node --test tests/*.unit.mjs",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "devDependencies": {
    "pyright": "git+https://github.com/microsoft/pyright.git#1.1.412"
  },
  "types": "./src/messages.d.ts",
  "exports": {
    ".": "./src/messages.d.ts",
    "./messages": "./src/messages.d.ts",
    "./declarations": "./src/declarations.d.ts"
  },
  "workerBundle": "./dist/pyright_worker.js",
  "browserDistribution": {
    "worker": "dist/pyright_worker.js",
    "assets": "assets",
    "runtimeManifest": "assets/runtime-manifest.json"
  }
}
