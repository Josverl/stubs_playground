{
  "name": "@mp-codemirror/pyright-worker",
  "version": "0.3.0",
  "description": "Worker-side protocol contract and packaging metadata",
  "license": "MIT",
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "src/declarations.d.ts",
    "src/messages.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node ../../scripts/check-worker-protocol-types.mjs && node --test tests/*.unit.mjs"
  },
  "types": "./src/messages.d.ts",
  "exports": {
    ".": "./src/messages.d.ts",
    "./messages": "./src/messages.d.ts",
    "./declarations": "./src/declarations.d.ts"
  },
  "workerBundle": "./dist/pyright_worker.js",
  "cdn": {
    "tagPrefix": "pyright-worker-v",
    "worker": "packages/pyright-worker/dist/pyright_worker.js",
    "assets": "packages/pyright-worker/assets"
  }
}
