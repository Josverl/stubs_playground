{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "pyright/packages/pyright-internal/src/server": ["./packages/pyright-worker/src/pyright-server.d.ts"]
    },
    "lib": ["ES2020", "WebWorker"],
    "outDir": "./packages/pyright-worker/dist",
    "strict": false,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["packages/pyright-worker/src/**/*.ts"],
  "exclude": ["node_modules", "packages/pyright-worker/dist"]
}
